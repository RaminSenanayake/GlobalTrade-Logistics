              "mode": "raw",
              "raw": "{\n  \"username\": \"logistic_user1\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"LOGISTIC_PERSONNEL\",\n  \"fullName\": \"John Logistics\",\n  \"email\": \"john@globaltrade.lk\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new system user. Roles: CUSTOMER, ADMIN, LOGISTIC_PERSONNEL, VENDOR, CUSTOM_OFFICIAL."
