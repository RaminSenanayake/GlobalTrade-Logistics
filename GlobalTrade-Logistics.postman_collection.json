    {
      "name": "4. Stateful Shipment Booking Workflow",
      "item": [
        {
          "name": "Step 1: Start Booking Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderUsername\": \"customer1\",\n  \"origin\": \"Colombo, Sri Lanka\",\n  \"destination\": \"Hamburg, Germany\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "start"]
            },
            "description": "Initializes stateful shipment booking session in JSON."
          }
        },
        {
          "name": "Step 2: Add Item to Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"description\": \"Optical Sensors Batch\",\n  \"quantity\": 25,\n  \"weightKg\": 5.2,\n  \"declaredValue\": 3400.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "items"]
            },
            "description": "Adds an inventory item/cargo piece to current active booking session."
          }
        },
        {
          "name": "Step 3: Remove Item from Booking",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/items/{{sku}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "items", "{{sku}}"]
            },
            "description": "Removes an item from current session by SKU."
          }
        },
        {
          "name": "Step 4: Select Carrier & Service Level",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"carrierCode\": \"MAERSK-SEA\",\n  \"serviceLevel\": \"EXPRESS_OCEAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/booking/carrier",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "carrier"]
            },
            "description": "Sets the preferred carrier and transit tier for the booking session."
          }
        },
        {
          "name": "Step 5: Get Booking Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "summary"]
            },
            "description": "Returns JSON summary of total weight, valuation, and rates."
          }
        },
        {
          "name": "Step 6: Confirm Booking (Generates Shipment)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "confirm"]
            },
            "description": "Finalizes the booking session into a persistent Shipment entity (JSON)."
          }
        },
        {
          "name": "Cancel Booking Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/booking/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "booking", "cancel"]
            },
            "description": "Cancels and discards the stateful booking session."
          }
        }
      ]
    },
